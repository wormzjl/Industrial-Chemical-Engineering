+    /**
+     * This support with the given flow phases dropped, as {@link #derive} drops a phase below the floor; this
+     * support itself when the drop removes nothing.
+     *
+     * <p>Used inside a frozen-support solve for a phase whose Newton column has died: a log-flow coordinate
+     * far below the floor whose finite-difference column is exactly zero, so the Newton matrix is singular on
+     * it. Such a phase is not an unknown the solve can move, and the support's own rule says it is not one.
+     * Only the named phases are cleared; every other point keeps its presence, also one below the floor
+     * (a converging solve passes many of those, and the refresh after it decides them from a solved state).
+     * The structural repairs of {@link #derive} then run on the result, so the drop is exactly the support a
+     * refresh would freeze if those phases alone had fallen below the floor. A feed-tray point is never
+     * dropped, as {@code derive} never drops one.</p>
+     *
+     * <p>The result has strictly fewer present phases or is this support: a repair that restores a dropped
+     * phase, or a drop that would empty a structural phase, leaves nothing to drop.</p>
+     */
+    V3TruncationSupport withoutPhases(V3ColumnProblem problem, List<V3DegreeOfFreedomLedger.UnknownId> deadPhases) {
+        Objects.requireNonNull(problem, "problem");
+        if (problem.truncationSupport() != this) {
+            throw new IllegalArgumentException("V3 support drop must act on its own problem's support");
+        }
+        byte[][] next = new byte[topology.nodeCount()][componentCount];
+        for (int node = 0; node < next.length; node++) {
+            for (int component = 0; component < componentCount; component++) {
+                next[node][component] = pointPhases(node, component).mask();
+            }
+        }
+        boolean cleared = false;
+        for (V3DegreeOfFreedomLedger.UnknownId id : deadPhases) {
+            if (id.node() == topology.feedTrayNumber()) continue;
+            int bit = switch (id.family()) {
+                case LIQUID_COMPONENT_FLOW -> LIQUID_BIT;
+                case VAPOR_COMPONENT_FLOW -> VAPOR_BIT;
+                default -> throw new IllegalArgumentException("V3 support drops only component flow phases");
+            };
+            if ((next[id.node()][id.component()] & bit) == 0) continue;
+            next[id.node()][id.component()] &= (byte) ~bit;
+            cleared = true;
+        }
+        if (!cleared) return this;
+        int pruned = settle(problem, next);
+        if (!phasesNonempty(problem, next)) return this;
+        V3TruncationSupport dropped = new V3TruncationSupport(
+                problem, cutoffMoleFraction, next, closurePrunedCount + pruned, note);
+        return dropped.presentPhaseCount() < presentPhaseCount() ? dropped : this;
+    }
+
+    /**
+     * The structural repairs every frozen support passes, applied to a phase mask in place; returns the points
+     * reachability pruned.
+     */
+    private static int settle(V3ColumnProblem problem, byte[][] phases) {
+        breakEquilibriumFreeCycles(problem, phases);
+        restoreEmptiedPhases(problem, phases);
+        int pruned = pruneUnreachable(problem, phases);
+        // Reachability has to be settled first: the guarantee is over the liquid the tray above actually
+        // keeps, and pruning is what decides that. The repair only adds phases, so nothing it writes can
+        // become unreachable, and a point it lifts out of ABSENT is reachable by the very edge that lifted it.
+        ensureSideDrawLiquid(problem, phases);
+        breakEquilibriumFreeCycles(problem, phases);
+        return pruned;
+    }
