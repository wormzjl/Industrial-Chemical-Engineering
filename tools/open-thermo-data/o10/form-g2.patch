+    /**
+     * The flow coordinate below its support floor ({@link #SUPPORT_FLOOR_LOG_FLOW}) on which a SINGULAR Newton
+     * matrix fails, or {@code -1}: the column whose pivot the LU could not take, else any such coordinate whose
+     * column is exactly zero.
+     */
+    private static int subFloorSingularCoordinate(
+            V3BandedPivotedSolver.Result.Failure failure, V3BandedMatrix matrix, V3DryMeshCoordinateMap coordinates,
+            double[] values) {
+        if (failure.code() != V3BandedPivotedSolver.FailureCode.SINGULAR) return -1;
+        int pivot = failure.singularColumn();
+        if (pivot >= 0 && belowSupportFloor(coordinates, values, pivot)) return pivot;
+        for (int column = 0; column < values.length; column++) {
+            if (!belowSupportFloor(coordinates, values, column)) continue;
+            boolean zero = true;
+            int lastRow = Math.min(matrix.size() - 1, column + matrix.lowerBandwidth());
+            for (int row = Math.max(0, column - matrix.upperBandwidth()); zero && row <= lastRow; row++) {
+                zero = matrix.get(row, column) == 0.0;
+            }
+            if (zero) return column;
+        }
+        return -1;
+    }
+
+    private static boolean belowSupportFloor(V3DryMeshCoordinateMap coordinates, double[] values, int index) {
+        V3DegreeOfFreedomLedger.UnknownFamily family = coordinates.unknowns().get(index).id().family();
