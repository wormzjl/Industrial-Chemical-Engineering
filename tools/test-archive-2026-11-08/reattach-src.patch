+    @Test
+    void anUnpoweredBusDoesNotProbeEveryLoadForEveryGenerator() {
+        int generators = 32, loads = 64;
+        var ports = new HashMap<UUID, DataPort>();
+        var wires = new ArrayList<DataBus.Cable>();
+        var stores = new HashMap<PowerGrid.Address, IEnergyStorage>();
+        var probes = new int[2];
+        for (int i = 0; i < generators + loads; i++) {
+            boolean generator = i < generators;
+            var cell = new BlockPos(i, 0, 0);
+            var face = generator ? Direction.WEST : Direction.EAST;
+            var id = new UUID(0, i + 1);
+            var p =
+                    new DataPort(
+                            id,
+                            generator ? DataPort.Kind.POWER_OUTPUT : DataPort.Kind.POWER_INPUT,
+                            0,
+                            DIM,
+                            cell.relative(face),
+                            cell.getCenter(),
+                            cell,
+                            face,
+                            0,
+                            0);
+            ports.put(id, p);
+            wires.add(
+                    new DataBus.Cable(
+                            new DataBus.Site(DIM, cell, 0),
+                            new ConduitGeometry.Key(48, 0, CableMedium.POWER),
+                            0,
+                            Map.of(face, id)));
+            stores.put(
+                    new PowerGrid.Address(DIM, p.owner(), face.getOpposite()),
+                    generator
+                            ? new EnergyStorage(100, 0, 100) {
+                                @Override
+                                public int extractEnergy(int amount, boolean simulate) {
+                                    probes[0]++;
+                                    return super.extractEnergy(amount, simulate);
+                                }
+                            }
+                            : new EnergyStorage(100, 100, 0) {
+                                @Override
+                                public boolean canReceive() {
+                                    probes[1]++;
+                                    return true;
+                                }
+                            });
+        }
+        var grid = new PowerGrid(new DataBus(wires, ports, CableMedium.POWER), ports, stores::get);
+        grid.tick();
+        assertEquals(generators, probes[0]);
+        assertEquals(0, probes[1], "no supply means no demand-side FE probes");
+    }
 }
